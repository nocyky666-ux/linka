{
  "appName":    "LINKA",
  "tagline":    "Connected Without Limits",
  "subTagline": "Offline · Private · Borderless",
  "version":    "2.0.0",
  "buildDate":  "2026-06",
  "appId":      "app.linka.connect",

  "assets": {
    "logo":      "assets/logo/logo.png",
    "fontText":  "assets/fonts/800.ttf",
    "fontEmoji": "assets/fonts/iOS18_4.ttf"
  },

  "fonts": {
    "text":  { "family":"LINKA800",   "file":"800.ttf",     "changeable":true,  "note":"Default text font — can be changed" },
    "emoji": { "family":"AppleEmoji", "file":"iOS18_4.ttf", "changeable":false, "note":"iOS 18.4 Apple Color Emoji — locked" }
  },

  "splash": {
    "type":   "logo",
    "file":   "assets/logo/logo.png",
    "note":   "Static logo with pulse glow animation — no Lottie/video needed"
  },

  "themes": {
    "default": { "blob1":"#0A84FF","blob2":"#5E5CE6","blob3":"#BF5AF2","label":"Biru/Ungu" },
    "cyber":   { "blob1":"#00F0FF","blob2":"#FF00E4","blob3":"#7000FF","label":"Cyber"     },
    "warm":    { "blob1":"#FF6B35","blob2":"#FF9F0A","blob3":"#E63946","label":"Hangat"    },
    "emerald": { "blob1":"#34E863","blob2":"#00D2FF","blob3":"#007A55","label":"Emerald"   },
    "rose":    { "blob1":"#FF375F","blob2":"#FF6B35","blob3":"#BF5AF2","label":"Rose"      }
  },

  "colors": {
    "background":"#000000",
    "primary":   "#0A84FF",
    "green":     "#30D158",
    "red":       "#FF453A",
    "purple":    "#BF5AF2"
  }
}
